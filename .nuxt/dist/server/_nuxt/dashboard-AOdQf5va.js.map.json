{"file":"dashboard-AOdQf5va.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;AAsDA,UAAM,EAAE,cAAyC,IAAI,iBAAgB;AAErE,UAAM,UAAU,CAAC,SAAS;AACxB,cAAQ,MAAI;AAAA,QACV,KAAK;AAAW,iBAAO;AAAA,QACvB,KAAK;AAAW,iBAAO;AAAA,QACvB,KAAK;AAAS,iBAAO;AAAA,QACrB;AAAS,iBAAO;AAAA,MACpB;AAAA,IACA;;;;AA9DO,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,4KAAwK,MAAA,CAAA,CAAA,ybAAA;AAOpK,UAAAC,MAAA,aAAA,EAAc,WAAM,GAAA;;;UACvB,MAAK;AAAA,UAAkB,MAAK;AAAA,UAAK,OAAM;AAAA;;;;;;AAK7BC,oBAAAD,MAAA,aAAA,IAAT,UAAK;6BAIgBE,eAAA,CAAA,EAAA,iBAAA,CAAA,MAAM,KAAI,GAAA,yHAAA,CAAA;;UAEsE,MAAM,SAAI,YAAA,sDAAiF,MAAM,SAAI,YAAA,gDAA2E,MAAM,SAAI,UAAA;;;UAO7R,MAAM,QAAQ,MAAM,IAAI;AAAA,UAAG,MAAK;AAAA;iMAIWC,eAAA,MAAM,KAAK,8EACHA,eAAA,MAAM,IAAI,gGAEFA,eAAA,MAAM,OAAO;AAErE,YAAA,CAAA,MAAM,MAAI;;;;;;;;;QAKxB,IAAG;AAAA,QACH,OAAM;AAAA,QACL,qBAAOC,KAAAA,MAAK,OAAA;AAAA;yBAHf,CAMW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAFV,0BAED;AAAA;;;;;;;;;;;;;;;;;;;;ACuGJ,UAAM,QAAQ,SAAQ;AACtB,UAAM,SAAS,UAAS;AACxB,UAAM,EAAE,MAAM,QAAQ,WAAqB,IAAI,QAAO;AACtD,UAAM,EAAiB,YAA6B,IAAI,iBAAgB;AACxE,UAAM,EAAE,MAAK,IAAK,QAAO;AACzB,UAAM,EAAE,UAAmB,IAAI,OAAM;AAErC,UAAM,gBAAgB,IAAI,KAAK;AAC/B,UAAM,cAAc,IAAI,KAAK;AAC7B,UAAM,kBAAkB,IAAI,KAAK;AAsBjC,UAAM,kBAAkB,SAAS,MAAM,MAAM,MAAM,OAAO,CAAC,KAAK,MAAM,MAAM,EAAE,aAAa,CAAC,CAAC;AAE7F,UAAM,YAAY;AAAA,MAChB,EAAE,OAAO,aAAa,IAAI,cAAc,MAAM,0BAAyB;AAAA,MACvE,EAAE,OAAO,mBAAmB,IAAI,mBAAmB,MAAM,wBAAuB;AAAA,MAChF,EAAE,OAAO,iBAAiB,IAAI,4BAA4B,MAAM,cAAa;AAAA,MAC7E,EAAE,OAAO,oBAAoB,IAAI,wBAAwB,MAAM,qBAAoB;AAAA,MACnF,EAAE,OAAO,sBAAsB,IAAI,sBAAsB,MAAM,iBAAgB;AAAA,MAC/E,EAAE,OAAO,YAAY,IAAI,uBAAuB,MAAM,qBAAoB;AAAA,MAC1E,EAAE,OAAO,aAAa,IAAI,wBAAwB,MAAM,mBAAkB;AAAA,MAC1E,EAAE,OAAO,WAAW,IAAI,sBAAsB,MAAM,qBAAoB;AAAA,IAC1E;AAEA,UAAM,YAAY,SAAS,MAAM;AAC/B,YAAM,UAAU,UAAU,KAAK,UAAQ,KAAK,OAAO,MAAM,IAAI;AAC7D,aAAO,UAAU,QAAQ,QAAQ;AAAA,IACnC,CAAC;AAED,UAAM,WAAW,SAAS,MAAM,KAAK,OAAO,YAAY,cAAc;AACtE,UAAM,aAAa,SAAS,MAAM,KAAK,OAAO,UAAU,eAAe;AACvE,UAAM,eAAe,SAAS,MAAM;AAClC,UAAI,CAAC,KAAK,OAAO,SAAU,QAAO;AAClC,aAAO,KAAK,MAAM,SAAS,MAAM,GAAG,EAAE,IAAI,OAAK,EAAE,CAAC,CAAC,EAAE,KAAK,EAAE,EAAE,cAAc,UAAU,GAAG,CAAC;AAAA,IAC5F,CAAC;AAMD,UAAM,oBAAoB,CAAC,UAAU;AACnC,kBAAY,QAAQ;AACpB,aAAO,KAAK,0BAA0B;AAAA,IACxC;AAEA,UAAM,gBAAgB,MAAM;AAC1B,sBAAgB,QAAQ;AACxB,iBAAU;AACV,aAAO,KAAK,QAAQ;AAAA,IACtB;;;;;;AAzNO,YAAA,OAAAR,eAAAC,WAAA,EAAA,OAAM,sFAAkF,MAAA,CAAA,CAAA,mBAAA;UAGnF,cAAA,OAAa;;;;;;;QAOwK,cAAA,QAAa,kBAAA;AAAA;AASvL,UAAAC,MAAA,SAAA,GAAW,QAAQ,QAAQ,aAAW;AAAG,cAAA,OAAAO,cAAA,OAAKP,MAAA,SAAA,EAAU,OAAO,OAAO,WAAW,CAAA,sDAAA;AAAA;AAC5E,cAAA,yBAAAG,eAAAH,MAAA,SAAA,GAAW,QAAQ,QAAQ,gBAAY,IAAA,CAAA,SAAA;AAAA;qIAGuBG,eAAAH,MAAA,SAAA,GAAW,QAAQ,QAAQ,YAAQ,gBAAA,mFACtDG,eAAAH,MAAA,SAAA,GAAW,QAAQ,QAAQ,WAAQ,kBAAA,gCAAA;AAQjFC,oBAAA,YAAR,SAAI;;UACV,KAAK,KAAK;AAAA,UACV,IAAI,KAAK;AAAA,UACT,qBAAO,cAAA,QAAa;AAAA,UACrB,OAAK,CAAC,iHACED,MAAA,KAAA,EAAM,SAAS,KAAK,KAAE,qDAAA,iDAAA;AAAA;2BANhC,CAmBW,GAAAK,QAAAC,UAAA,aAAA;;AAXE,kBAAAN,MAAA,KAAA,EAAM,SAAS,KAAK,IAAE;;;;;;gBAC1B,MAAM,KAAK;AAAA,gBAAM,MAAK;AAAA,gBAAM,OAAOA,MAAA,KAAA,EAAM,SAAS,KAAK,KAAE,oBAAA;AAAA;AAC7D,cAAAK,OAAA,IAAAF,eAAA,KAAK,KAAK,CAAA,GAAA;kBAGD,KAAK,UAAK,UAAe,gBAAA,QAAe,GAAA;oMAC/C,gBAAA,KAAe;;;;kBAER,KAAK,UAAK,mBAAwBH,MAAA,WAAA,IAAW,GAAA;8LACpDA,MAAA,WAAA,CAAW;;;;;;gBATLA,MAAA,KAAA,EAAM,SAAS,KAAK,mBAA/BQ,YAAiI,OAAA;AAAA;kBAA9F,OAAM;AAAA;gBACzCC,YAAoI,iBAAA;AAAA,kBAA7H,MAAM,KAAK;AAAA,kBAAM,MAAK;AAAA,kBAAM,OAAOT,MAAA,KAAA,EAAM,SAAS,KAAK,KAAE,oBAAA;AAAA;gBAAoEU,gBAAA,MACpIC,gBAAG,KAAK,KAAK,IAAG,KAGhB,CAAA;AAAA,gBAAY,KAAK,UAAK,UAAe,gBAAA,QAAe,kBAApDH,YAEO,QAAA;AAAA;kBAFmD,OAAM;AAAA,mCAC3D,gBAAA,KAAe,GAAA,CAAA;gBAER,KAAK,UAAK,mBAAwBR,MAAA,WAAA,IAAW,kBAAzDQ,YAEO,QAAA;AAAA;kBAFwD,OAAM;AAAA,mCAChER,MAAA,WAAA,CAAW,GAAA,CAAA;;;;;;;;AASF,UAAAA,MAAA,IAAA,GAAM,gBAAc;mCAAG,OAAKA,MAAA,IAAA,EAAK,cAAc,CAAA,iEAAA;AAAA;sDAC1C,aAAA,KAAY,CAAA,SAAA;AAAA;+IAG4B,SAAA,KAAQ,qIAC+B,WAAA,KAAU;;QAItG,MAAK;AAAA,QAAiB,MAAK;AAAA;;;QAazB,MAAK;AAAA,QAAc,MAAK;AAAA;wLAIyD,UAAA,KAAS,CAAA,qYAAA;;QAU1F,MAAK;AAAA,QAAgB,MAAK;AAAA,QAAK,OAAM;AAAA;8LAUD,YAAA,MAAW,GAAA,gGAAA,CAAA,CAAA,oBAAA;;QAE7C,MAAK;AAAA,QAAc,MAAK;AAAA;UAClBA,MAAA,WAAA,IAAW,GAAA;;;;;;UAGG,YAAA,OAAW;;UAAG,qBAAO,YAAA,QAAW;AAAA,UAAW,UAAQ;AAAA;;;;;;;;QAoBlF,QAAQ,gBAAA;AAAA,QACT,OAAM;AAAA,QACN,SAAQ;AAAA,QACR,aAAY;AAAA,QACZ,cAAa;AAAA,QACb,MAAK;AAAA,QACJ,WAAS;AAAA,QACT,sBAAQ,gBAAA,QAAe;AAAA;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderList","_ssrRenderClass","_ssrInterpolate","$emit","_push","_parent","_ssrRenderAttr","_createBlock","_createVNode","_createTextVNode","_toDisplayString"],"sources":["../../../../components/NotificationDropdown.vue","../../../../layouts/dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"absolute right-0 mt-4 w-96 bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden z-[100] animate-in fade-in zoom-in-95 duration-200 origin-top-right\">\n    <div class=\"p-6 border-b border-slate-50 flex items-center justify-between\">\n      <h3 class=\"text-base font-bold text-slate-800\">Notifications</h3>\n      <button @click=\"markAllAsRead\" class=\"text-[10px] font-black uppercase tracking-widest text-brand-cyan hover:text-[#003366] transition-colors\">Mark all as read</button>\n    </div>\n    \n    <div class=\"max-h-[400px] overflow-y-auto custom-scrollbar-light\">\n      <div v-if=\"notifications.length === 0\" class=\"p-12 text-center\">\n        <Icon name=\"lucide:bell-off\" size=\"32\" class=\"text-slate-200 mx-auto mb-3\" />\n        <p class=\"text-xs font-bold text-slate-400\">No new notifications</p>\n      </div>\n      \n      <div \n        v-for=\"notif in notifications\" \n        :key=\"notif.id\"\n        @click=\"handleSelect(notif)\"\n        class=\"p-5 hover:bg-slate-50 cursor-pointer transition-colors border-b border-slate-50 last:border-none flex gap-4 items-start\"\n        :class=\"{ 'bg-blue-50/30': !notif.read }\"\n      >\n        <div :class=\"[\n          'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border',\n          notif.type === 'success' ? 'bg-emerald-50 text-emerald-500 border-emerald-100' :\n          notif.type === 'warning' ? 'bg-amber-50 text-amber-500 border-amber-100' :\n          notif.type === 'error' ? 'bg-rose-50 text-rose-500 border-rose-100' :\n          'bg-blue-50 text-blue-500 border-blue-100'\n        ]\">\n          <Icon :name=\"getIcon(notif.type)\" size=\"18\" />\n        </div>\n        <div class=\"space-y-1 flex-1\">\n          <div class=\"flex items-center justify-between\">\n            <h4 class=\"text-sm font-bold text-slate-800\">{{ notif.title }}</h4>\n            <span class=\"text-[10px] font-medium text-slate-400\">{{ notif.time }}</span>\n          </div>\n          <p class=\"text-xs text-slate-500 leading-relaxed line-clamp-2\">{{ notif.message }}</p>\n        </div>\n        <div v-if=\"!notif.read\" class=\"w-2 h-2 bg-brand-cyan rounded-full mt-1.5 shrink-0\"></div>\n      </div>\n    </div>\n    \n    <NuxtLink \n      to=\"/dashboard/notifications\" \n      class=\"block p-4 text-center text-xs font-bold text-slate-500 hover:bg-slate-50 hover:text-[#003366] transition-all bg-slate-50/50\"\n      @click=\"$emit('close')\"\n    >\n      View all notifications\n    </NuxtLink>\n  </div>\n</template>\n\n<script setup>\nimport { useNotifications } from '@/composables/useNotifications'\n\nconst emit = defineEmits(['close', 'select'])\nconst { notifications, markAsRead, markAllAsRead } = useNotifications()\n\nconst getIcon = (type) => {\n  switch (type) {\n    case 'success': return 'lucide:check-circle'\n    case 'warning': return 'lucide:alert-triangle'\n    case 'error': return 'lucide:x-circle'\n    default: return 'lucide:info'\n  }\n}\n\nconst handleSelect = (notif) => {\n  markAsRead(notif.id)\n  emit('select', notif)\n}\n</script>\n\n<style scoped>\n.custom-scrollbar-light::-webkit-scrollbar {\n  width: 4px;\n}\n.custom-scrollbar-light::-webkit-scrollbar-track {\n  background: transparent;\n}\n.custom-scrollbar-light::-webkit-scrollbar-thumb {\n  background: rgba(0, 0, 0, 0.05);\n  border-radius: 10px;\n}\n</style>\n","<template>\n  <div class=\"min-h-screen bg-[#F8FAFC] font-sans text-slate-900 flex overflow-hidden relative\">\n    <!-- Mobile Sidebar Overlay -->\n    <div \n      v-if=\"isSidebarOpen\" \n      @click=\"isSidebarOpen = false\" \n      class=\"fixed inset-0 bg-brand-dark/40 backdrop-blur-sm z-[60] lg:hidden transition-opacity duration-300\"\n    ></div>\n\n    <!-- Sidebar -->\n    <aside \n      :class=\"[\n        'w-72 bg-[#003366] text-white flex-shrink-0 flex flex-col h-screen fixed lg:sticky top-0 z-[70] transition-transform duration-300 ease-in-out lg:translate-x-0',\n        isSidebarOpen ? 'translate-x-0' : '-translate-x-full'\n      ]\"\n    >\n      <!-- Logo Area -->\n      <div class=\"p-8 border-b border-white/5\">\n        <div class=\"flex items-center gap-4\">\n          <div class=\"h-10 w-10 bg-white rounded-xl flex items-center justify-center text-[#003366] font-black overflow-hidden\">\n            <img v-if=\"cmsConfig?.member?.portal?.sidebarLogo\" :src=\"cmsConfig.member.portal.sidebarLogo\" class=\"w-full h-full object-cover\" />\n            <span v-else>{{ cmsConfig?.member?.portal?.siteInitials || 'SC' }}</span>\n          </div>\n          <div>\n            <span class=\"font-bold text-white text-xs block uppercase tracking-widest\">{{ cmsConfig?.member?.portal?.siteName || 'Scientific Hub' }}</span>\n            <p class=\"text-[10px] text-white/60 font-medium mt-0.5\">{{ cmsConfig?.member?.portal?.siteName ? 'Member Portal' : 'Society for Cellular Pathology' }}</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Navigation -->\n      <nav class=\"flex-1 overflow-y-auto py-8 px-4 space-y-1.5 custom-scrollbar\">\n        <NuxtLink \n          v-for=\"item in menuItems\" \n          :key=\"item.label\"\n          :to=\"item.to\"\n          @click=\"isSidebarOpen = false\"\n          class=\"flex items-center gap-4 px-6 py-4 rounded-2xl text-sm font-bold transition-all group relative overflow-hidden\"\n          :class=\"route.path === item.to ? 'bg-white/10 text-white shadow-lg shadow-black/10' : 'text-white/50 hover:text-white hover:bg-white/5'\"\n        >\n          <div v-if=\"route.path === item.to\" class=\"absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-6 bg-brand-cyan rounded-r-full\"></div>\n          <Icon :name=\"item.icon\" size=\"18\" :class=\"route.path === item.to ? 'text-brand-cyan' : 'text-white/20 group-hover:text-white/60'\" />\n          {{ item.label }}\n          \n          <!-- Badge for Chat/Notif if needed -->\n          <span v-if=\"item.label === 'Chat' && unreadChatCount > 0\" class=\"ml-auto w-5 h-5 bg-brand-cyan text-[#003366] text-[10px] font-black rounded-full flex items-center justify-center\">\n            {{ unreadChatCount }}\n          </span>\n          <span v-if=\"item.label === 'Notifications' && unreadCount > 0\" class=\"ml-auto w-5 h-5 bg-rose-500 text-white text-[10px] font-black rounded-full flex items-center justify-center\">\n            {{ unreadCount }}\n          </span>\n        </NuxtLink>\n      </nav>\n\n      <!-- User Profile Summary (Sticky Bottom) -->\n      <div class=\"p-6 border-t border-white/5 bg-black/10\">\n        <div class=\"flex items-center gap-4 mb-4\">\n          <div class=\"w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center font-bold text-white border border-white/5\">\n             <img v-if=\"user?.profilePicture\" :src=\"user.profilePicture\" class=\"w-full h-full object-cover rounded-xl\" />\n             <span v-else>{{ userInitials }}</span>\n          </div>\n          <div class=\"min-w-0\">\n            <h4 class=\"text-sm font-bold tracking-tight truncate\">{{ userName }}</h4>\n            <span class=\"text-xs font-semibold text-emerald-400 block mt-0.5 uppercase tracking-tighter\">{{ userStatus }}</span>\n          </div>\n        </div>\n        <button @click=\"showLogoutModal = true\" class=\"w-full py-3 bg-rose-500/10 hover:bg-rose-500 text-rose-500 hover:text-white rounded-xl text-xs font-bold transition-all border border-rose-500/20 flex items-center justify-center gap-2\">\n          <Icon name=\"lucide:log-out\" size=\"14\" />\n          Logout\n        </button>\n      </div>\n    </aside>\n\n    <!-- Main Content Area -->\n    <main class=\"flex-1 flex flex-col h-screen overflow-hidden w-full relative\">\n      <!-- Top Header -->\n      <header class=\"h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 lg:px-10 shrink-0 z-[50]\">\n        <div class=\"flex items-center gap-4 lg:gap-8\">\n          <!-- Mobile Menu Toggle -->\n          <button @click=\"isSidebarOpen = true\" class=\"lg:hidden p-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors\">\n            <Icon name=\"lucide:menu\" size=\"24\" />\n          </button>\n          \n          <div class=\"hidden sm:block\">\n            <h2 class=\"text-lg lg:text-xl font-black text-slate-800 tracking-tighter uppercase\">{{ pageTitle }}</h2>\n          </div>\n\n          <!-- Tidy Search Bar -->\n          <div class=\"hidden lg:block w-64 group relative\">\n            <input \n              type=\"text\" \n              placeholder=\"Search registry...\" \n              class=\"w-full h-10 pl-10 pr-4 bg-slate-50 border border-slate-100 rounded-xl text-xs font-bold text-slate-700 focus:bg-white focus:ring-2 focus:ring-[#003366]/5 focus:border-[#003366]/20 outline-none transition-all placeholder:text-slate-400\"\n            />\n            <Icon name=\"lucide:search\" size=\"14\" class=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-[#003366] transition-colors\" />\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-2 lg:gap-6\">\n          <!-- Notification Button -->\n          <div class=\"relative\">\n            <button \n              @click=\"toggleNotifications\"\n              class=\"relative p-2.5 text-slate-400 hover:text-[#003366] hover:bg-slate-50 rounded-xl transition-all\"\n              :class=\"{ 'bg-slate-50 text-[#003366]': isNotifOpen }\"\n            >\n              <Icon name=\"lucide:bell\" size=\"20\" />\n              <span v-if=\"unreadCount > 0\" class=\"absolute top-2 right-2 w-2.5 h-2.5 bg-rose-500 border-2 border-white rounded-full\"></span>\n            </button>\n            \n            <NotificationDropdown v-if=\"isNotifOpen\" @close=\"isNotifOpen = false\" @select=\"handleNotifSelect\" />\n          </div>\n\n          <div class=\"hidden sm:block h-8 w-[1px] bg-slate-100 mx-2\"></div>\n          \n          <div class=\"flex items-center gap-3 bg-slate-50 px-4 py-2 rounded-xl border border-slate-100\">\n            <div class=\"text-right hidden sm:block\">\n              <p class=\"text-[10px] font-black text-[#003366] leading-none uppercase tracking-widest\">Cycle 2026</p>\n              <span class=\"text-[9px] font-bold text-emerald-500 uppercase mt-1 block\">Active Registry</span>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      <!-- Scrollable Viewport -->\n      <div class=\"flex-1 overflow-y-auto p-4 lg:p-10 custom-scrollbar-light bg-[#F8FAFC]\">\n        <slot />\n      </div>\n\n      <ConfirmModal\n        :isOpen=\"showLogoutModal\"\n        title=\"Secure Logout\"\n        message=\"Are you sure you want to end your current session? You will need to re-authenticate to access the registry.\"\n        confirmText=\"Logout\"\n        confirmStyle=\"danger\"\n        icon=\"lucide:log-out\"\n        @confirm=\"confirmLogout\"\n        @cancel=\"showLogoutModal = false\"\n      />\n    </main>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from 'vue'\nimport { useNotifications } from '@/composables/useNotifications'\nimport { useChat } from '@/composables/useChat'\nimport { useCMS } from '@/composables/useCMS'\n\nconst route = useRoute()\nconst router = useRouter()\nconst { user, logOut: logOutUser, loadUser } = useUser()\nconst { notifications, unreadCount, addNotification } = useNotifications()\nconst { chats } = useChat()\nconst { cmsConfig, loadCMS } = useCMS()\n\nconst isSidebarOpen = ref(false)\nconst isNotifOpen = ref(false)\nconst showLogoutModal = ref(false)\n\n// Rehydrate user state\nonMounted(async () => {\n  loadUser()\n  await loadCMS()\n  if (!user.value) {\n    router.push('/login')\n  } else {\n    // Trigger welcome notification\n    setTimeout(() => {\n      if (notifications.value.length < 5) {\n        addNotification({\n          title: 'Welcome Back',\n          message: `Welcome to the SCPSN Scientific Hub, ${user.value.fullName}. Your portal is synchronized.`,\n          type: 'info'\n        })\n      }\n    }, 2000)\n  }\n})\n\nconst unreadChatCount = computed(() => chats.value.reduce((acc, c) => acc + c.unreadCount, 0))\n\nconst menuItems = [\n  { label: 'Dashboard', to: '/dashboard', icon: 'lucide:layout-dashboard' },\n  { label: 'Scientific Chat', to: '/dashboard/chat', icon: 'lucide:message-square' },\n  { label: 'Notifications', to: '/dashboard/notifications', icon: 'lucide:bell' },\n  { label: 'Profile Registry', to: '/dashboard/portfolio', icon: 'lucide:user-circle' },\n  { label: 'Scientific Library', to: '/dashboard/library', icon: 'lucide:library' },\n  { label: 'Payments', to: '/dashboard/payments', icon: 'lucide:credit-card' },\n  { label: 'Abstracts', to: '/dashboard/abstracts', icon: 'lucide:file-text' },\n  { label: 'Support', to: '/dashboard/support', icon: 'lucide:help-circle' }\n]\n\nconst pageTitle = computed(() => {\n  const current = menuItems.find(item => item.to === route.path)\n  return current ? current.label : 'Scientific Portal'\n})\n\nconst userName = computed(() => user.value?.fullName || 'Practitioner')\nconst userStatus = computed(() => user.value?.status || 'Active Member')\nconst userInitials = computed(() => {\n  if (!user.value?.fullName) return 'SC'\n  return user.value.fullName.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2)\n})\n\nconst toggleNotifications = () => {\n  isNotifOpen.value = !isNotifOpen.value\n}\n\nconst handleNotifSelect = (notif) => {\n  isNotifOpen.value = false\n  router.push('/dashboard/notifications')\n}\n\nconst confirmLogout = () => {\n  showLogoutModal.value = false\n  logOutUser()\n  router.push('/login')\n}\n</script>\n\n<style scoped>\n.custom-scrollbar::-webkit-scrollbar {\n  width: 4px;\n}\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 10px;\n}\n\n.custom-scrollbar-light::-webkit-scrollbar {\n  width: 6px;\n}\n.custom-scrollbar-light::-webkit-scrollbar-track {\n  background: transparent;\n}\n.custom-scrollbar-light::-webkit-scrollbar-thumb {\n  background: rgba(0, 0, 0, 0.05);\n  border-radius: 10px;\n}\n\n.router-link-active {\n  background: rgba(255, 255, 255, 0.1);\n  color: white;\n}\n</style>\n"],"version":3}